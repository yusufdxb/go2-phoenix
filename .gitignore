# Benchmarks (keep summaries, drop raw)
benchmarks/raw/

# Local config overrides
configs/local/
.env
.env.local

# Sweep-generated per-cell configs (regenerated by scripts/sweep_run.py)
configs/_generated/

# Lab session captures (synced to T7, not committed)
data/lab/

# Local scratchpads (not part of the public repo)
hardware prompt run*.txt

# Internal lab notes and planning: kept in the Obsidian vault, not the public repo
docs/sessions/
docs/superpowers/
docs/attachments/
docs/LAB_CARD_NEXT.md
docs/adapt_load_debug.md

# training artifacts / scratch
checkpoints/
FIXLIST.md

# reliability Phase-3 rollouts + logs (large / transient); results*/ IS tracked
reliability_eval/raw/
reliability_eval/logs/
reliability_eval/raw_stand/
reliability_eval/logs_stand/
reliability_eval/raw_flat/
reliability_eval/logs_flat/

# Exported policy binaries (regenerable from the checkpoint via export.py).
# The shield artifact itself IS tracked: it is small and it is the deliverable.
deploy/*.onnx
deploy/*.onnx.data
deploy/*.pt

# Closed-loop study pilots are exploratory and not cited by any result.
# The per-arm .npz ARE tracked: at ~9 KB each they are what makes the headline
# numbers recomputable from a fresh clone (reliability_closed_loop_analyze.py
# reads nothing else), and a result nobody can recompute is not a result.
reliability_eval/*_pilot*
reliability_eval/closed_loop*/*_pilot*
