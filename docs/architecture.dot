// Phoenix v2 architecture. Render:
//   dot -Tsvg docs/architecture.dot -o docs/architecture.svg
digraph phoenix {
    rankdir=TB; nodesep=0.35; ranksep=0.45;
    bgcolor="white";
    newrank=true;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#3C4043", fillcolor="#F1F3F4"];
    edge [fontname="Helvetica", fontsize=9, color="#5F6368"];

    subgraph cluster_robot {
        label="On the GO2 (live, 50 Hz)";
        style="rounded"; color="#E37400"; fontname="Helvetica-Bold"; fontsize=12;
        node [fillcolor="#FFF3E0", color="#E37400"];
        policy  [label="Policy node\nONNX, raw action a"];
        gate    [label="Final actuator gate\nslew + limit clips, hold / damp\n(controlled degradation: X stages only)"];
        motors  [label="GO2 motors\nPD: kp (q_sent - q) - kd dq"];
        policy -> gate  [label="request\nq0 + 0.25 a"];
        gate   -> motors [label="sent q, kp, kd"];
    }

    subgraph cluster_monitor {
        label="DETECT  (phoenix.monitor, live tail of the bridge telemetry, read-only)";
        style="rounded"; color="#1A73E8"; fontname="Helvetica-Bold"; fontsize=12;
        node [fillcolor="#E8F0FE", color="#1A73E8"];
        layers  [label="Four-layer record\nrequest | node clip | sent | measured"];
        fidel   [label="Deployment-fidelity gate\n<= 5 % altered, >= 10 s authority"];
        health  [label="Health vector\ns_hat per joint vs nominal baseline\npersistence 8/10, global-shift veto"];
        layers -> fidel -> health;
    }

    subgraph cluster_sim {
        label="Between deployments (workstation, Isaac Lab)";
        style="rounded"; color="#188038"; fontname="Helvetica-Bold"; fontsize=12;
        node [fillcolor="#E6F4EA", color="#188038"];
        cond    [label="CONDITION  (phoenix.condition)\ntargeted range for the degraded joint\n+ nominal anchor"];
        train   [label="TRAIN\nPPO fine-tune from incumbent\n(same budget for every arm)"];
        verify  [label="VERIFY  (phoenix.validate)\ndegraded improves, nominal non-inferior,\nheld-out severity, ONNX parity"];
        cond -> train -> verify;
    }

    promote [shape=diamond, label="PROMOTE?", fillcolor="#FCE8E6", color="#C5221F", fontsize=10];

    motors -> layers  [label="LowState q, dq, tau_est", style=dashed];
    gate   -> layers  [label="bridge telemetry", style=dashed];
    health -> cond    [label="DEGRADED joint\n(range, not a point)"];
    verify -> promote;
    promote -> policy [label="yes: REDEPLOY\n(new incumbent)", color="#188038", fontcolor="#188038", constraint=false];
    promote -> train  [label="no: keep incumbent", color="#C5221F", fontcolor="#C5221F", style=dashed, constraint=false];
    { rank=same; policy; gate; motors; }
    { rank=same; layers; fidel; health; }
    { rank=same; cond; train; verify; }
}
